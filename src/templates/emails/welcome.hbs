<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Welcome to Estrella Kinetic Performance</title>
  <style>
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
    body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #1E2228; }
    @media screen and (max-width: 600px) {
      .email-container { width: 100% !important; }
      .card-body { padding: 28px 20px !important; }
      .feature-col { display: block !important; width: 100% !important; margin-bottom: 12px !important; }
      .cta-button { display: block !important; width: 100% !important; text-align: center !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #1E2228; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased;">

  <!-- Outer Wrapper -->
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #1E2228; min-height: 100vh;">
    <tr>
      <td align="center" style="padding: 40px 16px 48px 16px;">

        <!-- Main Card -->
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container" style="max-width: 560px; margin: 0 auto; background-color: #252A32; border: 1px solid #383E4D; border-radius: 18px; overflow: hidden; box-shadow: 0 8px 36px rgba(0, 0, 0, 0.55);">

          <!-- Header Section -->
          <tr>
            <td align="center" style="background-color: #2C3140; border-bottom: 1px solid #383E4D; padding: 32px 24px 24px 24px;">
              <!-- Logo -->
              <img src="cid:estrella-logo" alt="Estrella" width="130" style="display: block; max-width: 130px; height: auto; margin: 0 auto 12px auto; border: 0;" />
              <!-- Subtitle Badge -->
              <div style="font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #00D71B;">
                ESTRELLA &bull; KINETIC PERFORMANCE
              </div>
            </td>
          </tr>

          <!-- Hero Banner / Accent Line -->
          <tr>
            <td style="background: linear-gradient(90deg, #00D71B 0%, #10E52C 50%, #00B817 100%); height: 3px; font-size: 0; line-height: 0;">&nbsp;</td>
          </tr>

          <!-- Card Body -->
          <tr>
            <td class="card-body" style="padding: 38px 40px 36px 40px; text-align: left; background-color: #252A32;">

              <!-- Status Tag -->
              <div style="text-align: center; margin-bottom: 18px;">
                <span style="display: inline-block; background-color: rgba(0, 215, 27, 0.12); border: 1px solid rgba(0, 215, 27, 0.35); border-radius: 20px; padding: 5px 16px; font-size: 11px; font-weight: 700; letter-spacing: 1.8px; color: #00D71B; text-transform: uppercase;">
                  &#9679; Access Granted
                </span>
              </div>

              <!-- Main Title -->
              <h1 style="color: #FFFFFF; font-size: 24px; font-weight: 800; letter-spacing: 0.5px; text-align: center; margin: 0 0 10px 0; line-height: 1.25;">
                Welcome, <span style="color: #00D71B;">{{#if fullName}}{{fullName}}{{else}}Athlete{{/if}}</span>!
              </h1>

              <p style="color: #B0B8C8; font-size: 14px; line-height: 1.7; text-align: center; margin: 0 auto 30px auto; max-width: 440px;">
                You have successfully logged into your <strong style="color: #FFFFFF;">Estrella Kinetic Performance</strong> account. Your personalized training, performance metrics, and workout routines are ready.
              </p>

              <!-- Feature Highlights Box -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #1E2228; border: 1px solid #383E4D; border-radius: 14px; margin-bottom: 30px; overflow: hidden;">
                <tr>
                  <td style="padding: 20px 22px;">
                    <div style="color: #00D71B; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 14px;">
                      Your Member Privileges
                    </div>

                    <!-- Item 1 -->
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 12px;">
                      <tr>
                        <td width="28" valign="top" style="color: #00D71B; font-size: 15px; line-height: 1.2;">&#10003;</td>
                        <td style="color: #E2E8F0; font-size: 13px; line-height: 1.5;">
                          <strong style="color: #FFFFFF;">Tailored Workouts:</strong> Custom training routines designed for elite strength and agility.
                        </td>
                      </tr>
                    </table>

                    <!-- Item 2 -->
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 12px;">
                      <tr>
                        <td width="28" valign="top" style="color: #00D71B; font-size: 15px; line-height: 1.2;">&#10003;</td>
                        <td style="color: #E2E8F0; font-size: 13px; line-height: 1.5;">
                          <strong style="color: #FFFFFF;">Performance Tracking:</strong> Real-time logging of personal records, volume, and recovery.
                        </td>
                      </tr>
                    </table>

                    <!-- Item 3 -->
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                      <tr>
                        <td width="28" valign="top" style="color: #00D71B; font-size: 15px; line-height: 1.2;">&#10003;</td>
                        <td style="color: #E2E8F0; font-size: 13px; line-height: 1.5;">
                          <strong style="color: #FFFFFF;">Kinetic Guidance:</strong> Expert programming engineered for sustainable peak condition.
                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>

              <!-- Action Button -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 28px;">
                <tr>
                  <td align="center">
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                      <tr>
                        <td align="center" style="background-color: #00D71B; border-radius: 10px; box-shadow: 0 4px 20px rgba(0, 215, 27, 0.28);">
                          <a href="{{#if dashboardUrl}}{{dashboardUrl}}{{else}}#{{/if}}" class="cta-button" style="display: inline-block; padding: 14px 34px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 1px; color: #0A0A0A; text-decoration: none; text-transform: uppercase;">
                            Access Your Dashboard &rarr;
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Security Notice -->
              <div style="background-color: rgba(44, 49, 64, 0.5); border-left: 3px solid #00D71B; border-radius: 4px; padding: 12px 16px; margin-bottom: 26px;">
                <p style="color: #94A3B8; font-size: 12px; line-height: 1.55; margin: 0;">
                  <strong style="color: #CBD5E1;">Security Alert:</strong> If this login was not performed by you, please reset your password immediately or contact support.
                </p>
              </div>

              <!-- Divider -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 0 0 20px 0;">
                <tr>
                  <td style="border-top: 1px solid #383E4D;"></td>
                </tr>
              </table>

              <!-- Footer info inside card -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td align="center">
                    <div style="font-size: 14px; color: #00D71B; letter-spacing: 6px; margin-bottom: 10px;">&#10022;&nbsp;&nbsp;&#10022;&nbsp;&nbsp;&#10022;</div>
                    <p style="color: #6B7585; font-size: 11px; margin: 0; line-height: 1.5;">
                      &copy; {{currentYear}} Estrella Kinetic Performance. All rights reserved.
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>
        </table>

        <!-- Outer Sub-footer -->
        <p style="color: #5A6270; font-size: 11px; margin: 18px 0 0 0; text-align: center;">
          This automated security notification was sent to your registered Estrella account.
        </p>

      </td>
    </tr>
  </table>

</body>
</html>
