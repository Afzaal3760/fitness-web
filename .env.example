# ==============================================
# Fitness Web API - Environment Configuration Example
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/fitness_web

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_access_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key
JWT_REFRESH_EXPIRES_IN=30d

# Nodemailer / Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="Fitness App" <no-reply@fitnessapp.com>
